# Morning Brief 환경변수 예시. 실제 값을 채워 .env 로 복사하거나 GitHub Actions 시크릿/변수로 등록하세요.
# 아무것도 설정하지 않아도 `run --fixtures` 로 샘플 사이트가 생성됩니다.

# ── 텔레그램 수집 ─────────────────────────────────────────────
# 1차: 공개 채널 미리보기(https://t.me/s/ehdwl) — 자격증명 불필요.
# 2차(폴백): Telethon 개인 세션. https://my.telegram.org 에서 API ID/HASH 발급 후 세션 문자열 생성:
#   python - <<'PY'
#   from telethon.sync import TelegramClient
#   from telethon.sessions import StringSession
#   api_id=int(input("api_id: ")); api_hash=input("api_hash: ")
#   with TelegramClient(StringSession(), api_id, api_hash) as c:
#       print(c.session.save())
#   PY
TELEGRAM_CHANNEL=ehdwl
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# ── Claude 구조화 요약 ────────────────────────────────────────
ANTHROPIC_API_KEY=
MORNING_BRIEF_MODEL=claude-opus-5

# ── 사이트 ──────────────────────────────────────────────────
MORNING_BRIEF_BASE_URL=https://mctaki23-glitch.github.io/morning_brief
MORNING_BRIEF_OUT=site
MORNING_BRIEF_ARCHIVE=archive
MORNING_BRIEF_CHART_DAYS=20
# 공식 로고 SVG 경로 (없으면 로고 영역을 비움 — 워드마크 흉내 금지)
MORNING_BRIEF_LOGO=
# 운영 모드: 샘플·합성 데이터 폴백 금지 (production | true)
MORNING_BRIEF_ENV=
MORNING_BRIEF_TZ=Asia/Seoul

# ── 알림(옵션) ───────────────────────────────────────────────
# 실패·미게시 알림을 받을 텔레그램 봇 토큰과 채팅 ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=
